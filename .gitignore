# Cached MITRE ATT&CK STIX bundles (large, re-downloaded on demand)
data/*.json
data/*.tmp

# Python
__pycache__/
*.pyc
.venv/
venv/

# Build and test output
build/
dist/
*.egg-info/
.coverage
htmlcov/
.pytest_cache/
node_modules/
playwright-report/
test-results/
.audit-cache/
frontend/choose-actor-preview.png
tmp/pdfs/*.pdf
tmp/pdfs/*.png

# Lint and type-checker caches (both tools also self-ignore, but be explicit)
.mypy_cache/
.ruff_cache/

# Claude Code: ignore the directory contents but keep the shared project
# permission rules. Excluding ".claude/" outright would stop git descending
# into it, and a "!" exception cannot re-include a file under an excluded
# directory — so the contents are excluded instead.
.claude/*
!.claude/settings.json
