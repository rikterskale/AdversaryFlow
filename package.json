{
  "name": "adversaryflow-frontend",
  "private": true,
  "version": "0.5.3",
  "scripts": {
    "build:frontend": "vite build --config frontend/vite.config.ts",
    "dev:frontend": "vite --config frontend/vite.config.ts",
    "test:frontend": "vitest run --config frontend/vitest.config.ts",
    "check:frontend": "tsc --project frontend/tsconfig.json --noEmit && npm run build:frontend && npm run test:frontend",
    "check:frontend-assets": "git diff --exit-code -- frontend/index.html frontend/styles.css frontend/app.js frontend/favicon.svg",
    "pretest:e2e": "npm run build:frontend",
    "test:e2e": "node tests/e2e/run.js"
  },
  "dependencies": {
    "@tanstack/react-query": "5.103.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "ajv": "8.20.0",
    "autoprefixer": "10.6.1",
    "jsdom": "30.1.1",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
