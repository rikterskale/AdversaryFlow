{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rikterskale/AdversaryFlow/schemas/adversaryflow-execution.schema.json",
  "title": "AdversaryFlow portable execution summary",
  "type": "object",
  "required": [
    "schema_version", "run_id", "status", "actor_id", "platform",
    "plan_sha256", "csv_sha256", "started_at", "completed_at",
    "operator_b64", "target_b64", "completed_steps", "failed_steps",
    "skipped_steps", "events_file", "results_file", "report_file",
    "markdown_report_file"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "run_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "status": { "enum": ["completed", "aborted", "interrupted", "failed"] },
    "actor_id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$" },
    "platform": { "enum": ["windows", "linux", "macos"] },
    "plan_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "csv_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "operator_b64": { "type": "string", "contentEncoding": "base64" },
    "target_b64": { "type": "string", "contentEncoding": "base64" },
    "completed_steps": { "type": "integer", "minimum": 0 },
    "failed_steps": { "type": "integer", "minimum": 0 },
    "skipped_steps": { "type": "integer", "minimum": 0 },
    "events_file": { "const": "evidence-events.jsonl" },
    "results_file": { "const": "execution-results.csv" },
    "report_file": { "const": "execution-report.html" },
    "markdown_report_file": { "const": "execution-report.md" }
  },
  "additionalProperties": false
}
