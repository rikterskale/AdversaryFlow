{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rikterskale/AdversaryFlow/schemas/adversaryflow-intelligence.schema.json",
  "title": "AdversaryFlow structured intelligence review",
  "description": "A bounded, provenance-preserving set of ATT&CK mapping candidates. Candidates are not accepted until a reviewer records an explicit decision.",
  "type": "object",
  "required": ["schema_version", "source", "actor", "data_version", "comparison", "candidates"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "source": { "$ref": "#/$defs/source" },
    "actor": { "$ref": "#/$defs/actor" },
    "data_version": { "type": "string", "minLength": 1 },
    "comparison": { "$ref": "#/$defs/comparison" },
    "candidates": { "type": "array", "minItems": 1, "maxItems": 4000, "items": { "$ref": "#/$defs/candidate" } }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["kind", "name", "url", "sha256"],
      "properties": {
        "kind": { "enum": ["csv", "navigator_layer", "stix2_bundle"] },
        "name": { "type": "string", "minLength": 1, "maxLength": 300 },
        "url": { "type": ["string", "null"], "format": "uri", "pattern": "^https://" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "actor": {
      "type": "object",
      "required": ["stix_id", "attack_id", "name", "type"],
      "properties": {
        "stix_id": { "type": "string", "minLength": 1 },
        "attack_id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "type": { "enum": ["group", "campaign"] }
      },
      "additionalProperties": false
    },
    "comparison": {
      "type": "object",
      "required": ["report_only", "attack_only", "both"],
      "properties": {
        "report_only": { "$ref": "#/$defs/techniqueIds" },
        "attack_only": { "$ref": "#/$defs/techniqueIds" },
        "both": { "$ref": "#/$defs/techniqueIds" }
      },
      "additionalProperties": false
    },
    "techniqueIds": {
      "type": "array",
      "items": { "type": "string", "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$" },
      "uniqueItems": true
    },
    "candidate": {
      "type": "object",
      "required": ["candidate_id", "technique_id", "technique_name", "tactics", "platforms", "source_kind", "source_name", "source_url", "source_sha256", "evidence_quote", "procedure", "confidence", "review_status", "reviewed_by", "reviewed_at", "accepted_by", "accepted_at", "technique_url", "technique_known", "catalog_source", "abilities"],
      "properties": {
        "candidate_id": { "type": "string", "pattern": "^[a-f0-9]{24}$" },
        "technique_id": { "type": "string", "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$" },
        "technique_name": { "type": "string", "maxLength": 300 },
        "tactics": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "platforms": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "source_kind": { "enum": ["csv", "navigator_layer", "stix2_bundle"] },
        "source_name": { "type": "string", "minLength": 1, "maxLength": 300 },
        "source_url": { "type": ["string", "null"], "format": "uri", "pattern": "^https://" },
        "source_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "evidence_quote": { "type": "string", "maxLength": 2000 },
        "procedure": { "type": "string", "maxLength": 2000 },
        "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "review_status": { "enum": ["needs_review", "accepted", "rejected"] },
        "reviewed_by": { "type": "string", "maxLength": 120 },
        "reviewed_at": { "type": "string", "maxLength": 40 },
        "accepted_by": { "type": "string", "maxLength": 120 },
        "accepted_at": { "type": "string", "maxLength": 40 },
        "technique_url": { "type": ["string", "null"], "format": "uri", "pattern": "^https://" },
        "technique_known": { "type": "boolean" },
        "catalog_source": { "enum": ["curated", "fallback", "unsupported"] },
        "abilities": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["ability_id", "platform", "executor", "fidelity", "safety_class", "content_source", "review_status", "content_sha256", "requires_admin", "requires_network", "cleanup_available"],
            "properties": {
              "ability_id": { "type": "string", "pattern": "^[a-f0-9]{24}$" },
              "platform": { "enum": ["windows", "linux", "macos"] },
              "executor": { "enum": ["cmd", "powershell", "bash"] },
              "fidelity": { "enum": ["direct", "bounded_synthetic", "lab_proxy"] },
              "safety_class": { "enum": ["none", "low", "medium", "high"] },
              "content_source": { "type": "string", "minLength": 1 },
              "review_status": { "enum": ["unassessed", "draft", "reviewed", "retired"] },
              "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "requires_admin": { "type": "boolean" },
              "requires_network": { "type": "boolean" },
              "cleanup_available": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
