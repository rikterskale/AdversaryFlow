{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rikterskale/AdversaryFlow/schemas/adversaryflow-content-pack.schema.json",
  "title": "AdversaryFlow signed content pack manifest",
  "type": "object",
  "required": ["schema_version", "pack_id", "pack_version", "attack_version", "files", "signer_key_id", "signature"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "pack_id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$" },
    "pack_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
    "attack_version": { "type": "string", "minLength": 1, "maxLength": 100 },
    "files": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 2,
      "required": ["abilities.json"],
      "properties": {
        "abilities.json": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "detection_bindings.json": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "signer_key_id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$" },
    "signature": { "type": "string", "minLength": 80, "maxLength": 100, "contentEncoding": "base64" }
  },
  "additionalProperties": false
}
