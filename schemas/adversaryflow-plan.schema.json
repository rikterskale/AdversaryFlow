{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rikterskale/AdversaryFlow/schemas/adversaryflow-plan.schema.json",
  "title": "AdversaryFlow plan export",
  "type": "object",
  "required": ["schema_version", "tool", "tool_version", "data_version", "domains", "generated", "actor", "scope", "execution_context", "summary", "stages"],
  "properties": {
    "schema_version": { "const": "2.0" },
    "tool": { "const": "AdversaryFlow" },
    "tool_version": { "type": "string", "minLength": 1 },
    "data_version": { "type": "string", "minLength": 1 },
    "domains": { "type": "array", "items": { "enum": ["enterprise", "ics", "mobile"] }, "minItems": 1, "uniqueItems": true },
    "generated": { "type": "string", "format": "date-time" },
    "actor": { "$ref": "#/$defs/actor" },
    "scope": { "$ref": "#/$defs/scope" },
    "execution_context": { "$ref": "#/$defs/executionContext" },
    "summary": { "$ref": "#/$defs/summary" },
    "stages": { "type": "array", "items": { "$ref": "#/$defs/stage" }, "maxItems": 32 }
  },
  "$defs": {
    "actor": {
      "type": "object",
      "required": ["stix_id", "attack_id", "name", "type", "aliases", "description", "technique_count"],
      "properties": {
        "stix_id": { "type": "string", "minLength": 1 },
        "attack_id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "type": { "enum": ["group", "campaign"] },
        "aliases": { "type": "array", "items": { "type": "string" } },
        "description": { "type": "string" },
        "technique_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "required": ["command_platform", "include_pre", "curated_only", "allow_network", "allow_admin", "allow_high_risk", "stages"],
      "properties": {
        "command_platform": { "enum": ["windows", "linux", "macos"] },
        "include_pre": { "type": "boolean" },
        "curated_only": { "type": "boolean" },
        "allow_network": { "type": "boolean" },
        "allow_admin": { "type": "boolean" },
        "allow_high_risk": { "type": "boolean" },
        "stages": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "executionContext": {
      "type": "object",
      "required": ["operator", "target"],
      "properties": {
        "operator": { "type": "string", "maxLength": 120 },
        "target": { "type": "string", "maxLength": 200 }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": ["techniques", "runnable", "unsupported", "stages", "curated", "fallback", "marked_run"],
      "properties": {
        "techniques": { "type": "integer", "minimum": 0 },
        "runnable": { "type": "integer", "minimum": 0 },
        "unsupported": { "type": "integer", "minimum": 0 },
        "stages": { "type": "integer", "minimum": 0 },
        "curated": { "type": "integer", "minimum": 0 },
        "fallback": { "type": "integer", "minimum": 0 },
        "marked_run": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "stage": {
      "type": "object",
      "required": ["tactic", "title", "techniques"],
      "properties": {
        "tactic": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "techniques": { "type": "array", "items": { "$ref": "#/$defs/technique" }, "maxItems": 2000 }
      },
      "additionalProperties": false
    },
    "technique": {
      "type": "object",
      "required": ["id", "name", "url", "platforms", "command_source", "supported", "command", "run", "execution"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": ["string", "null"], "format": "uri" },
        "platforms": { "type": "array", "items": { "type": "string" } },
        "command_source": { "enum": ["curated", "fallback"] },
        "supported": { "type": "boolean" },
        "command": { "$ref": "#/$defs/command" },
        "run": { "type": "boolean" },
        "execution": { "$ref": "#/$defs/execution" }
      },
      "additionalProperties": false
    },
    "command": {
      "type": "object",
      "required": ["platform", "command", "note", "cleanup", "risk", "side_effects", "requires_admin", "requires_network", "network_targets", "prerequisites", "expected_telemetry", "expected_output", "timeout_seconds", "rollback", "cleanup_required", "acknowledgment_required"],
      "properties": {
        "platform": { "type": "string" },
        "command": { "type": "string", "maxLength": 10000 },
        "note": { "type": "string" },
        "cleanup": { "type": "string" },
        "risk": { "enum": ["none", "low", "medium", "high"] },
        "side_effects": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "requires_admin": { "type": "boolean" },
        "requires_network": { "type": "boolean" },
        "network_targets": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "prerequisites": { "type": "array", "items": { "type": "string" } },
        "expected_telemetry": { "type": "string" },
        "expected_output": { "type": "string" },
        "timeout_seconds": { "type": "integer", "minimum": 0, "maximum": 3600 },
        "rollback": { "type": "string" },
        "cleanup_required": { "type": "boolean" },
        "acknowledgment_required": { "type": "boolean" },
        "exercise_kind": { "enum": ["technique_relevant_bounded"] },
        "fidelity": { "enum": ["bounded_synthetic"] },
        "evidence_source": { "enum": ["self_reported_receipt"] },
        "unsupported": { "type": "boolean" },
        "restricted": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": ["outcome"],
      "properties": {
        "outcome": { "enum": ["not_run", "passed", "failed", "skipped"] },
        "updated_at": { "type": "string", "format": "date-time" },
        "operator": { "type": "string", "maxLength": 120 },
        "target": { "type": "string", "maxLength": 200 },
        "notes": { "type": "string", "maxLength": 500 },
        "cleanup_completed": { "type": "boolean" },
        "run_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "started_at": { "type": "string", "format": "date-time" },
        "completed_at": { "type": "string", "format": "date-time" },
        "exit_code": { "type": "integer", "minimum": -255, "maximum": 65535 },
        "stdout_sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "stderr_sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "receipt_sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "receipt_verified": { "type": "boolean" },
        "telemetry_refs": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 500 }, "maxItems": 20, "uniqueItems": true },
        "evidence_source": { "enum": ["operator_supplied", "exercise_receipt", "endpoint_verified", "siem_verified"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
